<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-android</TargetFramework>

		<RootNamespace>MotorDsl.Pax</RootNamespace>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>

		<!--
		Solo net10.0-android. Este paquete es el CONTRATO de la impresora interna del PAX A910S
		(IPaxPrinterDevice) mas el transporte, el mapeo de errores, el simulador y el perfil; no trae
		ningun binario del SDK del fabricante. La implementacion real de IPaxPrinterDevice es externa
		y se registra con PaxPrinterOptions.RealDeviceFactory. Las fuentes se escriben SIN tipos
		Android y MotorDsl.Tests (net10.0) las enlaza por fuente, igual que
		BluetoothPrinterTransport.Chunking.cs.
		-->

		<PackageId>MotorDsl.Pax</PackageId>
		<Authors>Fernando Rafael Filipuzzi</Authors>
		<Description>Transport de impresion para la impresora interna del PAX A910S (Android) para MotorDsl: contrato IPaxPrinterDevice, transport que envia el PNG de raster-preview, mapeo de errores e impresora simulada. La implementacion real del dispositivo es externa (RealDeviceFactory).</Description>
		<PackageTags>maui;thermal;dsl;printing;pax;a910s</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/Aplicada-Streaming/PrintThermal_Motor_Maui</RepositoryUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<PropertyGroup>
		<AndroidLdFlags>-Wl,-z,max-page-size=16384</AndroidLdFlags>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\MotorDsl.Printing.Abstractions\MotorDsl.Printing.Abstractions.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.8" />
	</ItemGroup>

</Project>
